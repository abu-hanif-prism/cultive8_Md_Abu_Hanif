FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Token budget / upload limits (all optional)
CONTEXT_WINDOW_TOKENS=2048
SYSTEM_PROMPT_RESERVE_TOKENS=450
CONTEXT_RESERVE_TOKENS=250
OUTPUT_RESERVE_TOKENS=512
MAX_UPLOAD_MB=50

# Analysis
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:0.8b
OLLAMA_TIMEOUT_S=120
# Mimic the 2 vCPU / no-GPU target (optional):
# OLLAMA_NUM_GPU=0
# OLLAMA_NUM_THREAD=2
CHUNK_MAX_RETRIES=2
SUMMARY_CAP_TOKENS=230
TH_FAILED_LOGINS=5
TH_DENIED=3
TH_RATE_PER_MINUTE=10
TH_PROBE_PATHS=3
TH_ESCALATE_MIN_FAILS=3
KEEP_UPLOADS=0
CIRCUIT_BREAKER_FAILURES=3
